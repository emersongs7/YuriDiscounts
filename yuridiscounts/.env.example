# Copie este arquivo para .env e ajuste os valores conforme necessário.

# Quando true, a ScraperFactory sempre devolve o MockScraper (dados simulados),
# permitindo validar o fluxo completo sem depender dos sites reais.
MOCK_MODE=true

# Timeout (segundos) para requisicoes HTTP dos scrapers reais.
REQUEST_TIMEOUT=10

# User-Agent enviado nas requisicoes para reduzir bloqueios triviais.
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36

# Nivel de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Score minimo (0-100) do fuzzy matching para considerar uma oferta valida
MIN_MATCH_SCORE=55

# Diretorio onde os relatorios exportados (JSON/CSV) serao salvos
EXPORT_DIR=data
